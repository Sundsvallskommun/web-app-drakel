# APP NAME
APP_NAME=Drakel
# PORT
PORT=3001
# Base prefix to be added to all end-points
BASE_URL_PREFIX=/api
# Sundsvalls kommun API end-point
API_BASE_URL=https://api-test.sundsvall.se
# Credentials used for API
CLIENT_KEY={{INSERT CLIENT_KEY}}
CLIENT_SECRET={{INSERT CLIENT SECRET}}

# SAML
# Backend URLs - full URLS
SAML_CALLBACK_URL=http://localhost:3001/api/saml/login/callback
SAML_LOGOUT_CALLBACK_URL=http://localhost:3001/api/saml/logout/callback
SAML_FAILURE_REDIRECT=http://localhost:3001/api/saml/login

# Fallback if provided URL is invalid.
SAML_SUCCESS_REDIRECT=http://localhost:3000

SAML_ENTRY_SSO=http://{{domain-to-sso}}/sso
SAML_IDP_PUBLIC_CERT="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"

SAML_ISSUER=passport-saml
SAML_PRIVATE_KEY="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"
SAML_PUBLIC_KEY="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"
# Optional SAML hardening, on by default. 'false' only for an IdP that signs just the response, not each assertion.
SAML_WANT_ASSERTIONS_SIGNED=
# always (default): a response must answer a login drakel started. ifPresent also allows IdP-initiated login; never disables.
SAML_VALIDATE_IN_RESPONSE_TO=

# Signs the session cookie. In production: a random value of at least 32 characters (a placeholder is warned about at startup).
SECRET_KEY=changeme

# Swagger
SWAGGER_ENABLED=true

# LOG - for prod use "combined" LOG_FORMAT
LOG_FORMAT=dev
LOG_DIR=../../data/logs

# CORS AND REDIRECT
ORIGIN=http://localhost:3000,http://localhost:3002

CREDENTIALS=true
# --- Caremanagement / tenant (backend only - frontend is agnostic) ---
# caremanagement, Templating and Active Directory are reached through the API gateway (API_BASE_URL), with its
# token — unless CAREMANAGEMENT_BASE_URL / TEMPLATING_BASE_URL give caremanagement or Templating a host of their own,
# which is then called directly without the token. Contract generation only: CAREMANAGEMENT_OPENAPI_URL may point at
# another caremanagement OpenAPI (URL or local file, e.g. a branch's openapi.yaml the gateway does not publish yet).
MUNICIPALITY_ID=
CAREMANAGEMENT_NAMESPACE=
# Optional: call caremanagement directly on this host (e.g. https://cm.drakel.sundsvall.dev) instead of via the gateway.
CAREMANAGEMENT_BASE_URL=
# Optional: call Templating directly on this host (e.g. https://templating.drakel.sundsvall.dev) instead of via the gateway.
TEMPLATING_BASE_URL=
ACTIVE_DIRECTORY_DOMAIN=
MESSAGING_DEPARTMENT=
MESSAGING_SUPPORT_TEXT=
MESSAGING_SUPPORT_EMAIL=
MESSAGING_SUPPORT_PHONE=
MESSAGING_SUPPORT_URL=
# --- Authorization (comma-separated AD groups) ---
AUTHORIZED_GROUPS=
ADMIN_GROUP=
TEMPLATE_ADMIN_GROUP=
LOG_ADMIN_GROUP=
