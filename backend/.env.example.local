# APP NAME
APP_NAME=Drakel
# PORT
PORT=3001
# Base prefix to be added to all end-points
BASE_URL_PREFIX=/api
# Sundsvalls kommun API end-point
API_BASE_URL=https://api-test.sundsvall.se
# Credentials used for API
CLIENT_KEY={{INSERT CLIENT_KEY}}
CLIENT_SECRET={{INSERT CLIENT SECRET}}

# SAML
# Backend URLs - full URLS
SAML_CALLBACK_URL=http://localhost:3001/api/saml/login/callback
SAML_LOGOUT_CALLBACK_URL=http://localhost:3001/api/saml/logout/callback
SAML_FAILURE_REDIRECT=http://localhost:3001/api/saml/login

# Fallback if provided URL is invalid.
SAML_SUCCESS_REDIRECT=http://localhost:3000

SAML_ENTRY_SSO=http://{{domain-to-sso}}/sso
SAML_IDP_PUBLIC_CERT="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"

SAML_ISSUER=passport-saml
SAML_PRIVATE_KEY="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"
SAML_PUBLIC_KEY="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"

# Used for encryption
SECRET_KEY=changeme

# Swagger
SWAGGER_ENABLED=true

# LOG - for prod use "combined" LOG_FORMAT
LOG_FORMAT=dev
LOG_DIR=../../data/logs

# CORS AND REDIRECT
ORIGIN=http://localhost:3000,http://localhost:3002

CREDENTIALS=true
# --- Caremanagement / tenant (backend only - frontend is agnostic) ---
MUNICIPALITY_ID=
CAREMANAGEMENT_BASE_URL=
CAREMANAGEMENT_NAMESPACE=
TEMPLATING_BASE_URL=
# --- Lifecare (optional - unset means the integration is not wired in this environment) ---
# Host only, no path. The BFF builds the rest.
LIFECARE_BASE_URL=https://lifecare.sundsvall.se
# The four values Lifecare's entry URL carries:
#   /WE.Flow.Html?domain={DOMAIN}&Actor={ACTOR}&IDPMethod={IDP_METHOD}
LIFECARE_DOMAIN=SundsvallVoO_PLUS
LIFECARE_ACTOR=Actor_Professional
LIFECARE_IDP_METHOD=saml
LIFECARE_FEDERATION_PROFILE=Sundsvall_Intra
# The internal CA that issued the certificates for lifecare.sundsvall.se and the identity provider.
# Without it Node fails the TLS handshake with "unable to get local issuer certificate" - your
# browser succeeds only because Windows trusts the CA and Node has its own trust store.
# Paste the whole chain (root, and any intermediate) into one double-quoted value.
LIFECARE_CA_CERT="-----BEGIN CERTIFICATE-----\n{{INSERT_CA_CERT}}\n-----END CERTIFICATE-----\n"
# Stopgap while you do not have the CA: skips verifying Lifecare's certificate entirely. The
# traffic stays encrypted but nobody checks who is on the other end - and the integration
# account's password and personal data both cross that connection. Only affects Lifecare calls.
# Set to "true" to turn verification off. Logs an error on every start outside development.
LIFECARE_INSECURE_TLS=
# The integration account the BFF signs in as. Setting LIFECARE_USERNAME is what makes the BFF
# sign itself in; leave both blank and it falls back to the pasted-session scaffolding below.
# The account must be able to sign in with username and password alone - a one-time code cannot
# be answered by a server.
LIFECARE_USERNAME=
# One password. On the browser sign-in the letters are typed into the field and the digits are
# clicked on the scrambled on-screen keypad, in the password's own order.
LIFECARE_PASSWORD={{INSERT LIFECARE PASSWORD}}
# Leave blank: the BFF signs in over plain HTTP. Set to "true" only as a fallback, to sign in by
# driving a headless browser instead. Costs Chromium (and its system libraries) on the server and
# seconds per sign-in, paid once per session.
LIFECARE_BROWSER_SIGN_IN=
# How long a signed-in Lifecare session is reused before it is proactively re-established, in
# minutes. A proxy for Lifecare's own inactivity timeout; the session also re-signs-in reactively
# if Lifecare drops it sooner. The session is persisted to data/lifecare-session.json and reused
# across restarts. Defaults to 20.
LIFECARE_SESSION_TTL_MINUTES=
# Development only: set to "true" to run the sign-in browser visibly (and slowed down) so you can
# watch the flow. Leave off everywhere else - a server has no screen to show it on.
LIFECARE_BROWSER_HEADED=
# Development scaffolding only, and only used while LIFECARE_USERNAME is blank. A session copied
# from devtools while signed in to Lifecare - it belongs to a real user and expires within the
# hour. Never set outside .env.development.local.
LIFECARE_SESSION_COOKIE=
ACTIVE_DIRECTORY_BASE_URL=
ACTIVE_DIRECTORY_DOMAIN=
MESSAGING_ORGANIZATION_NUMBER=
MESSAGING_DEPARTMENT=
MESSAGING_SUPPORT_TEXT=
MESSAGING_SUPPORT_EMAIL=
MESSAGING_SUPPORT_PHONE=
MESSAGING_SUPPORT_URL=
# --- Authorization (comma-separated AD groups) ---
AUTHORIZED_GROUPS=
ADMIN_GROUP=
TEMPLATE_ADMIN_GROUP=
LOG_ADMIN_GROUP=
# Test environments only: register beslut in Lifecare under this beslutsfattare (e.g. RPA_031DEV)
# instead of the handläggare's own account, which Lifecare's test environment does not know.
# Never set in production — there a beslut must name the handläggare.
LIFECARE_TEST_DECISION_MAKER=
# Lifecare print template for beslut PDFs (preview and what is sent to the sökande)
LIFECARE_DECISION_PRINT_TEMPLATE_ID=885bfb68-c97b-47c0-921d-ef00caaa2423
